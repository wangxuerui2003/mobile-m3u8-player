<?xml version="1.0" encoding="utf-8"?>
<!--
    Trust anchors for TLS connections.
    System CAs cover most sites, but the video CDN (*.yaaabc.com, and other
    okzyw-linked CDNs) rotates to CAs that some trimmed OEM CA stores
    (e.g. HyperOS China builds) do not ship, which breaks every HTTPS
    playback/download with a handshake failure. Bundling the extra public
    root below keeps playback working on those devices.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <!-- Certum Trusted Root CA (Asseco Data Systems S.A., PL), valid to 2043.
                 SHA-256 fingerprint:
                 FE:76:96:57:38:55:77:3E:37:A9:5E:7A:D4:D9:CC:96:
                 C3:01:57:C1:5D:31:76:5B:A9:B1:57:04:E1:AE:78:FD -->
            <certificates src="@raw/certum_trusted_root_ca" />
        </trust-anchors>
    </base-config>
</network-security-config>
